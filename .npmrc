# Pin the public registry. Without this, a global ~/.npmrc pointing at a
# private mirror bakes that host into package-lock.json's resolved URLs,
# which leaks internal infrastructure and breaks CI on public runners.
registry=https://registry.npmjs.org/

# npm 10.9.2's arborist crashes ("Cannot read properties of null (reading
# 'edgesOut')") building vitest's peer set for this dependency graph. The
# peers themselves are fine; the resolver is not. Revisit when npm 11 is
# the floor.
legacy-peer-deps=true
