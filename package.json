{
  "name": "overdb",
  "version": "0.1.0",
  "private": true,
  "description": "A multi-environment database client. Query, diff, and monitor the same database across local, staging, and prod at once.",
  "license": "Apache-2.0",
  "author": "Lionel Farr <lionel@codelionsllc.com>",
  "contributors": [
    "Lionel Farr <lionel@codelionsllc.com>",
    "Owen Farr <owen@codelionsllc.com>"
  ],
  "homepage": "https://github.com/overcodelions/overdb",
  "repository": {
    "type": "git",
    "url": "https://github.com/overcodelions/overdb.git"
  },
  "bugs": {
    "url": "https://github.com/overcodelions/overdb/issues"
  },
  "main": "dist/main/index.js",
  "files": [
    "dist/",
    "build/",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "productName": "Overdb",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "concurrently -k -n vite,tsc,electron -c cyan,yellow,magenta \"npm:dev:renderer\" \"npm:dev:tsc\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:tsc": "tsc -p tsconfig.main.json --watch --preserveWatchOutput",
    "dev:electron": "wait-on http://localhost:5373 dist/main/index.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5373 electron .",
    "build": "npm run build:main && npm run build:renderer && npm run check:dist",
    "build:main": "node scripts/clean-dist.mjs && tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "check:dist": "node scripts/check-dist.mjs",
    "start": "electron .",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "test": "vitest run",
    "test:watch": "vitest",
    "security:aws-account-ids": "node scripts/check-no-aws-account-ids.mjs",
    "security:identities": "node scripts/check-no-forbidden-identities.mjs --all"
  },
  "build": {
    "appId": "com.overdb.app",
    "productName": "Overdb",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/main/**/*",
      "dist/preload/**/*",
      "dist/shared/**/*",
      "dist/db/**/*",
      "dist/dbhost/**/*",
      "dist/renderer/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraMetadata": {
      "main": "dist/main/index.js"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "notarize": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "category": "Development",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^41.7.0",
    "electron-builder": "^26.8.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.16",
    "typescript": "^6.0.3",
    "vite": "^6.0.3",
    "vitest": "4.1.11",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1128.0",
    "@aws-sdk/client-redshift": "^3.1129.0",
    "@aws-sdk/credential-providers": "^3.1128.0",
    "@aws-sdk/rds-signer": "^3.1129.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.9.6",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@lezer/highlight": "^1.2.1",
    "@tanstack/react-virtual": "^3.13.12",
    "mysql2": "^3.11.5",
    "pg": "^8.13.1",
    "pg-cursor": "^2.12.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.13"
  }
}
